# ============================================
# School ERP — Backend Configuration
# ============================================
# Copy to backend/.env:  cp backend/.env.example backend/.env

# ---- Database (MySQL) ----
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# URL-encode special characters in the password (@ -> %40, # -> %23, / -> %2F).
#
# Local XAMPP / MariaDB (root, no password):
DATABASE_URL="mysql://root@127.0.0.1:3306/school_erp"
#
# Hostinger example (values from hPanel -> Databases -> Management):
# DATABASE_URL="mysql://u123456789_erp:YourPassword@localhost:3306/u123456789_school_erp"

# ---- JWT (REQUIRED in production) ----
# Generate each with:  openssl rand -hex 32
JWT_SECRET=""
JWT_REFRESH_SECRET=""
JWT_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# ---- Report Card QR signing ----
REPORT_CARD_SECRET=""

# ---- Server ----
PORT=3000
NODE_ENV=development
# Origin allowed by CORS. In production set this to your real frontend origin.
FRONTEND_URL=http://localhost:5173

# ---- File Uploads ----
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

# ---- PDF rendering ----
# Leave unset to use Puppeteer's bundled Chromium (installed by
# `npx puppeteer browsers install chrome`). Set this when using a
# system Chromium, e.g. on a VPS:
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# ---- Email (SMTP) — optional ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Mother Teresa Foundation School <noreply@mtfschool.edu>"

# ---- URLs ----
APP_URL=http://localhost:3000
API_URL=http://localhost:3000/api

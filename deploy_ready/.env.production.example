# ============================================
# SCHOOL ERP — HOSTINGER PRODUCTION TEMPLATE
# ============================================
# Rename to .env inside the backend folder on the server.
# Every value below must be filled in.

# ---- MySQL (from hPanel -> Databases -> MySQL Databases) ----
# URL-encode special characters in the password: @ -> %40, # -> %23, / -> %2F
#
# Your Hostinger credentials:
#   Database: u544715275_bmts
#   Username: u544715275_bmts
#   Host:     srv1954.hstgr.io
#   Port:     3306
DATABASE_URL="mysql://u544715275_bmts:YOUR_ENCODED_PASSWORD@srv1954.hstgr.io:3306/u544715275_bmts"

# ---- Secrets: generate each with  openssl rand -hex 32 ----
JWT_SECRET=""
JWT_REFRESH_SECRET=""
REPORT_CARD_SECRET=""

JWT_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# ---- Server ----
NODE_ENV=production
PORT=3000

# ---- CORS / URLs ----
# Public origin of the FRONTEND. Required: in production CORS allows only this.
FRONTEND_URL="https://shubham.sanjivanitalenthub.com"
APP_URL="https://shubham.sanjivanitalenthub.com"
API_URL="https://shubham.sanjivanitalenthub.com/api"

# ---- Uploads ----
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

# ---- PDF rendering (server-side report card download) ----
# Not available on shared hosting. On a VPS:
#   sudo apt-get install -y chromium-browser
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser

# ---- Email (optional) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Mother Teresa Foundation School <noreply@mtfschool.edu>"

# ============================================
# School ERP — Docker Compose Configuration
# ============================================
# Copy to .env in the project root before running docker compose:
#   cp .env.example .env
#
# Only values consumed by docker-compose.yml belong here.
# To run the backend directly (npm run dev), see backend/.env.

# ---- MySQL (REQUIRED) ----
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=school_erp
MYSQL_USER=school_erp_user
MYSQL_PASSWORD=

# ---- Secrets (REQUIRED — compose refuses to start without them) ----
# Generate each with:  openssl rand -hex 32
JWT_SECRET=
JWT_REFRESH_SECRET=
REPORT_CARD_SECRET=

# ---- Token lifetimes ----
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ---- Public URLs ----
# Host port Nginx publishes on (serves the frontend, proxies /api).
HTTP_PORT=80
FRONTEND_URL=http://localhost
APP_URL=http://localhost
API_URL=http://localhost/api

# ---- File uploads ----
MAX_FILE_SIZE=5242880

# ---- Email (SMTP) — optional, leave blank to disable outbound mail ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Mother Teresa Foundation School <noreply@mtfschool.edu>"
